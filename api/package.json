  "scripts": {
    "dev": "node --watch index.js",
    "db:create": "node ./src/migrations/01.create-tables.js",
    "db:seed": "node ./src/migrations/02.seed-tables.js",
    "db:reset": "npm run db:create && npm run db:seed",
    "test:unit": "node --test tests/*.unit.test.js",
    "test:spec": "node --test --env-file=.env.test --import ./tests/config/global-setup.js --experimental-test-isolation=none tests/*.spec.test.js",
    "test": "npm run test:unit && npm run test:spec"
  },
