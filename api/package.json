    "http-status-codes": "^2.3.0",
    "joi": "^18.2.9",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  },
